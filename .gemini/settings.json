{
  "ui": {
    "showLineNumbers": false
  },
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/git-mcp-server"
      ]
    },
    "chunkhound": {
      "command": "chunkhound",
      "args": [
        "mcp",
        ".",
        "--db",
        ".chunkhound/db"
      ]
    }
  }
}
